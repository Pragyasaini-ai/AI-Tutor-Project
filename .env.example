# ── Gemini (Cloud) ────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com — no credit card required.
# Confirm the current free Flash model ID in AI Studio (it changes frequently).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (Local) ────────────────────────────────────────────────────────────
# Install Ollama from https://ollama.com, then run: ollama pull llama3.2
# The base URL below is the default; change it if Ollama runs on a different port.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
